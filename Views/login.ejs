<%- include("partials/header") -%>

<main class="eco-auth-wrapper" style="background-color: var(--eco-surface-alt);">
  <div class="eco-card eco-auth-card">
    <div class="text-center mb-4">
      <h1 style="color: var(--eco-primary-dark); font-size: 28px; margin-bottom: 8px;">Welcome Back</h1>
      <p style="color: var(--eco-text-secondary); font-size: 15px;">Log in to your EcoPulse account to continue.</p>
    </div>

    <!-- Social Logins -->
    <div class="d-flex justify-content-center gap-3 mb-4">
      <a href="/auth/google" class="btn-eco-ghost" style="border: 1px solid var(--eco-border); padding: 8px 16px;"><i class="fa-brands fa-google text-dark"></i></a>
      <a href="/auth/github" class="btn-eco-ghost" style="border: 1px solid var(--eco-border); padding: 8px 16px;"><i class="fa-brands fa-github text-dark"></i></a>
      <a href="/auth/facebook" class="btn-eco-ghost" style="border: 1px solid var(--eco-border); padding: 8px 16px;"><i class="fa-brands fa-facebook" style="color: #1877F2;"></i></a>
    </div>

    <div class="d-flex align-items-center mb-4">
      <div style="flex: 1; height: 1px; background: var(--eco-border);"></div>
      <div style="padding: 0 16px; color: var(--eco-text-secondary); font-size: 14px;">or continue with email</div>
      <div style="flex: 1; height: 1px; background: var(--eco-border);"></div>
    </div>

    <form action="/login" method="post">
      <div class="eco-form-group">
        <label for="loginUsername" class="eco-label">Username</label>
        <input type="text" class="eco-input" id="loginUsername" name="loginUsername" required placeholder="Enter your username">
      </div>
      <div class="eco-form-group">
        <label for="loginPassword" class="eco-label">Password</label>
        <input type="password" class="eco-input" id="loginPassword" name="loginPassword" required placeholder="••••••••">
      </div>
      
      <div class="mt-4">
        <button type="submit" class="btn-eco-primary w-100" style="padding: 14px;">Log In</button>
      </div>
      
      <div class="text-center mt-4 text-muted" style="font-size: 14px;">
        Don't have an account? <a href="/signup" style="font-weight: 600;">Sign up</a>
      </div>
    </form>
  </div>
</main>

<%- include("partials/footer") -%>
