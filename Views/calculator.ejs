<%- include("partials/header") -%>

<main style="background-color: var(--eco-surface-alt); min-height: 100vh; padding-top: 40px; padding-bottom: 60px;">
  <div class="eco-container" style="max-width: 700px;">
    
    <div class="eco-card">
      <div class="text-center mb-4">
        <h1 style="color: var(--eco-primary-dark); font-size: 32px;">Calculate Your Footprint</h1>
        <p style="color: var(--eco-text-secondary);">Your responses are used only to calculate your carbon footprint.</p>
      </div>
      
      <form action="/calculator" method="post" onkeydown="handleFormKeyDown(event)">
        
        <!-- Step 1 -->
        <div class="step" id="step1">
          <div class="d-flex align-items-center gap-2 mb-3">
            <div style="background: var(--eco-accent-soft); padding: 8px 12px; border-radius: var(--eco-radius-sm); color: var(--eco-primary);">
              <i class="fa-solid fa-house"></i>
            </div>
            <h3 style="margin: 0;">Step 1: Household Information</h3>
          </div>
          
          <div class="eco-form-group">
            <label class="eco-label" for="numpeople">Number of people in your house <span class="text-danger">*</span></label>
            <input type="number" class="eco-input" name="numpeople" required min="1" placeholder="e.g. 4">
          </div>
          <div class="eco-form-group">
            <label class="eco-label" for="electricity">Electricity used per month (in kWh) <span class="text-danger">*</span></label>
            <input type="number" class="eco-input" name="electricity" required min="0" placeholder="e.g. 250 (enter 0 if none)">
          </div>
          <div class="eco-form-group">
            <label class="eco-label" for="cylinders">Number of LPG cylinders used last month <span class="text-danger">*</span></label>
            <input type="number" class="eco-input" name="cylinders" required min="0" placeholder="e.g. 1 (enter 0 if none)">
          </div>
          
          <div class="mt-4">
            <button type="button" class="btn-eco-primary w-100" onclick="nextStep()">Next: Travel Information</button>
          </div>
        </div>
        
        <!-- Step 2 -->
        <div class="step" id="step2" style="display: none;">
          <div class="d-flex align-items-center gap-2 mb-3">
            <div style="background: var(--eco-accent-soft); padding: 8px 12px; border-radius: var(--eco-radius-sm); color: var(--eco-primary);">
              <i class="fa-solid fa-car"></i>
            </div>
            <h3 style="margin: 0;">Step 2: Travel Information</h3>
          </div>
          
          <div class="eco-form-group">
            <label class="eco-label">Flight Time (in hours) last month <span class="text-danger">*</span></label>
            <input type="number" class="eco-input" placeholder="e.g. 2 (enter 0 if none)" min="0" name="flights">
          </div>
          <div class="eco-form-group">
            <label class="eco-label">Average Distance travelled by your vehicle (in kms) <span class="text-danger">*</span></label>
            <input type="number" class="eco-input" placeholder="e.g. 300 (enter 0 if none)" min="0" name="vehicle">
          </div>
          <div class="eco-form-group">
            <label class="eco-label">Mileage of your Vehicle (km/L)</label>
            <input type="number" class="eco-input" placeholder="e.g. 15 (default 15 if no car)" min="1" name="mileage">
          </div>
          <div class="eco-form-group">
            <label class="eco-label">Distance Travelled in Bus (in kms) <span class="text-danger">*</span></label>
            <input type="number" class="eco-input" placeholder="e.g. 50 (enter 0 if none)" min="0" name="bus">
          </div>
          <div class="eco-form-group">
            <label class="eco-label">Distance Travelled By Train (in kms) <span class="text-danger">*</span></label>
            <input type="number" class="eco-input" placeholder="e.g. 100 (enter 0 if none)" min="0" name="train">
          </div>
          
          <div class="mt-4">
            <button type="button" class="btn-eco-primary w-100" onclick="nextStep()">Next: Dietary Preference</button>
          </div>
        </div>
          
        <!-- Step 3 -->
        <div class="step" id="step3" style="display: none;">
          <div class="d-flex align-items-center gap-2 mb-3">
            <div style="background: var(--eco-accent-soft); padding: 8px 12px; border-radius: var(--eco-radius-sm); color: var(--eco-primary);">
              <i class="fa-solid fa-utensils"></i>
            </div>
            <h3 style="margin: 0;">Step 3: Dietary Preference</h3>
          </div>
          
          <div class="eco-form-group">
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="meatLover" value="re" id="diet1">
              <label class="form-check-label" for="diet1">Meat Lover</label>
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="omnivore" value="re" id="diet2" checked>
              <label class="form-check-label" for="diet2">Average Omnivore</label>
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="vegetarian" value="re" id="diet3">
              <label class="form-check-label" for="diet3">Vegetarian</label>
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="vegan" value="re" id="diet4">
              <label class="form-check-label" for="diet4">Vegan</label>
            </div>
          </div>
          
          <div class="mt-4">
            <button type="button" class="btn-eco-primary w-100" onclick="nextStep()">Next: Recycling Habits</button>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="step" id="step4" style="display: none;">
          <div class="d-flex align-items-center gap-2 mb-3">
            <div style="background: var(--eco-accent-soft); padding: 8px 12px; border-radius: var(--eco-radius-sm); color: var(--eco-primary);">
              <i class="fa-solid fa-recycle"></i>
            </div>
            <h3 style="margin: 0;">Step 4: Recycling Habits</h3>
          </div>
          
          <div class="eco-form-group">
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" value="re" name="newspaper" id="flexCheckDefault1">
              <label class="form-check-label" for="flexCheckDefault1">Recycle Newspaper</label>
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" value="re" name="Aluminium" id="flexCheckDefault2">
              <label class="form-check-label" for="flexCheckDefault2">Recycle Aluminium</label>
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" value="re" name="Plastic" id="flexCheckDefault3">
              <label class="form-check-label" for="flexCheckDefault3">Recycle Plastic</label>
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" value="re" name="Glass" id="flexCheckDefault4">
              <label class="form-check-label" for="flexCheckDefault4">Recycle Glass</label>
            </div>
          </div>
          
          <div class="mt-4">
            <button type="submit" class="btn-eco-primary w-100" style="background-color: var(--eco-primary-dark);">Calculate Carbon Footprint</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</main>

<script>
  const steps = document.querySelectorAll('.step');
  let currentStep = 0;

  function handleFormKeyDown(event) {
    if (event.key === 'Enter') {
      event.preventDefault();
      if (currentStep < steps.length - 1) {
        nextStep();
      } else {
        document.querySelector('form').submit();
      }
    }
  }

  function validateCurrentStep() {
    if (currentStep === 0) {
      const numPeople = document.querySelector('input[name="numpeople"]');
      const electricity = document.querySelector('input[name="electricity"]');
      const cylinders = document.querySelector('input[name="cylinders"]');

      if (!numPeople || !numPeople.value.trim() || Number(numPeople.value) <= 0) {
        alert("Please enter the number of people in your house (minimum 1).");
        if (numPeople) numPeople.focus();
        return false;
      }
      if (!electricity || electricity.value.trim() === '') {
        alert("Please enter electricity usage in kWh (enter 0 if none).");
        if (electricity) electricity.focus();
        return false;
      }
      if (!cylinders || cylinders.value.trim() === '') {
        alert("Please enter LPG cylinders used last month (enter 0 if none).");
        if (cylinders) cylinders.focus();
        return false;
      }
    } else if (currentStep === 1) {
      const flights = document.querySelector('input[name="flights"]');
      const vehicle = document.querySelector('input[name="vehicle"]');
      const bus = document.querySelector('input[name="bus"]');
      const train = document.querySelector('input[name="train"]');

      if (!flights || flights.value.trim() === '') {
        alert("Please enter flight time in hours (enter 0 if none).");
        if (flights) flights.focus();
        return false;
      }
      if (!vehicle || vehicle.value.trim() === '') {
        alert("Please enter vehicle distance in kms (enter 0 if none).");
        if (vehicle) vehicle.focus();
        return false;
      }
      if (!bus || bus.value.trim() === '') {
        alert("Please enter bus travel distance in kms (enter 0 if none).");
        if (bus) bus.focus();
        return false;
      }
      if (!train || train.value.trim() === '') {
        alert("Please enter train travel distance in kms (enter 0 if none).");
        if (train) train.focus();
        return false;
      }
    }
    return true;
  }

  function nextStep() {
    if (!validateCurrentStep()) {
      return; 
    }

    if (currentStep < steps.length - 1) {
      steps[currentStep].style.display = 'none';
      currentStep++;
      steps[currentStep].style.display = 'block';
    }
  }
</script>

<%- include("partials/footer") -%>
