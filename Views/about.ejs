<%- include("partials/header") -%>

<main style="background-color: var(--eco-bg); min-height: 100vh;">
  <section class="eco-hero" style="background: linear-gradient(135deg, var(--eco-primary-dark) 0%, var(--eco-primary) 100%); color: white; padding: 80px 24px;">
    <div class="eco-container text-center">
      <h1 style="color: white; font-size: 48px; font-weight: 800; margin-bottom: 24px;">About EcoPulse</h1>
      <p style="font-size: 18px; opacity: 0.9; max-width: 700px; margin: 0 auto; line-height: 1.6;">
        We are the creators of EcoPulse, a professional organization dedicated to making our planet a better place to live through data-driven carbon intelligence.
      </p>
    </div>
  </section>

  <section class="eco-section eco-container">
    <div class="text-center mb-5">
      <h2 style="color: var(--eco-primary-dark);">What Do We Do?</h2>
    </div>

    <div class="eco-grid eco-grid-3">
      <!-- Card 1 -->
      <div class="eco-card d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/aboutcard1.jpg" alt="How we started" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 24px; flex-grow: 1;">
          <h3 style="font-size: 20px; margin-bottom: 12px;">How We Started</h3>
          <p style="font-size: 15px; color: var(--eco-text-secondary); margin-bottom: 0;">
            Climate change is the challenge of our generation. At EcoPulse, we provide advanced tools for individuals and businesses to monitor their carbon emissions and offer solutions for a cleaner, greener earth.
          </p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="eco-card d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/aboutcard2.jpeg" alt="Our Motivation" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 24px; flex-grow: 1;">
          <h3 style="font-size: 20px; margin-bottom: 12px;">Our Motivation</h3>
          <p style="font-size: 15px; color: var(--eco-text-secondary); margin-bottom: 0;">
            We are deeply committed to a sustainable future and have a profound respect for our planet. Our motivation stems from the urgency to act upon climate change predictions, ensuring a world where all life thrives.
          </p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="eco-card d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/aboutcard3.jpg" alt="Join the Initiative" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 24px; flex-grow: 1;">
          <h3 style="font-size: 20px; margin-bottom: 12px;">Join the Initiative</h3>
          <p style="font-size: 15px; color: var(--eco-text-secondary); margin-bottom: 0;">
            Our planet faces an existential crisis. Join our movement towards a sustainable future and a clean, green planet. Explore personalized AI insights for individuals and robust reporting for businesses.
          </p>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include("partials/footer") -%>
