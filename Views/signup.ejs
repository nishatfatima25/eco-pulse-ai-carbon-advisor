<%- include("partials/header") -%>

<main class="eco-auth-wrapper" style="background-color: var(--eco-surface-alt); padding: 60px 24px;">
  <div class="eco-card eco-auth-card" style="max-width: 560px;">
    <div class="text-center mb-4">
      <h1 style="color: var(--eco-primary-dark); font-size: 28px; margin-bottom: 8px;">Create an Account</h1>
      <p style="color: var(--eco-text-secondary); font-size: 15px;">Join EcoPulse and start reducing your carbon footprint today.</p>
    </div>

    <!-- Social Logins -->
    <div class="d-flex justify-content-center gap-3 mb-4">
      <a href="/auth/google" class="btn-eco-ghost" style="border: 1px solid var(--eco-border); padding: 8px 16px;"><i class="fa-brands fa-google text-dark"></i></a>
      <a href="/auth/github" class="btn-eco-ghost" style="border: 1px solid var(--eco-border); padding: 8px 16px;"><i class="fa-brands fa-github text-dark"></i></a>
      <a href="/auth/facebook" class="btn-eco-ghost" style="border: 1px solid var(--eco-border); padding: 8px 16px;"><i class="fa-brands fa-facebook" style="color: #1877F2;"></i></a>
    </div>

    <div class="d-flex align-items-center mb-4">
      <div style="flex: 1; height: 1px; background: var(--eco-border);"></div>
      <div style="padding: 0 16px; color: var(--eco-text-secondary); font-size: 14px;">or sign up with email</div>
      <div style="flex: 1; height: 1px; background: var(--eco-border);"></div>
    </div>

    <form action="/signup" method="post">
      <div class="eco-grid" style="grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
        <div class="eco-form-group" style="margin-bottom: 0;">
          <label for="name" class="eco-label">Full Name</label>
          <input type="text" class="eco-input" id="name" name="name" required>
        </div>
        <div class="eco-form-group" style="margin-bottom: 0;">
          <label for="mobno" class="eco-label">Mobile No.</label>
          <input type="tel" class="eco-input" id="mobno" name="mobno" pattern="[0-9]{10}" required placeholder="10 digits">
        </div>
      </div>
      
      <div class="eco-form-group">
        <label for="username" class="eco-label">Username</label>
        <input type="text" class="eco-input" id="username" name="username" required>
      </div>
      
      <div class="eco-form-group">
        <label for="email" class="eco-label">Email</label>
        <input type="email" class="eco-input" id="email" name="email" required>
      </div>
      
      <div class="eco-grid" style="grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
        <div class="eco-form-group" style="margin-bottom: 0;">
          <label for="password" class="eco-label">Password</label>
          <input type="password" class="eco-input" id="password" name="password" required>
        </div>
        <div class="eco-form-group" style="margin-bottom: 0;">
          <label for="confirmPassword" class="eco-label">Confirm Password</label>
          <input type="password" class="eco-input" id="confirmPassword" name="confirmPassword" required>
        </div>
      </div>

      <div class="form-check mt-3 mb-4">
        <input type="checkbox" class="form-check-input" id="termscheck" required style="cursor: pointer;">
        <label class="form-check-label" for="termscheck" style="font-size: 14px; color: var(--eco-text-secondary); cursor: pointer;">
          I agree to the terms and conditions
        </label>
      </div>
      
      <div>
        <button type="submit" class="btn-eco-primary w-100" style="padding: 14px;">Create Account</button>
      </div>
      
      <div class="text-center mt-4 text-muted" style="font-size: 14px;">
        Already have an account? <a href="/login" style="font-weight: 600;">Log in</a>
      </div>
    </form>
  </div>
</main>

<%- include("partials/footer") -%>
