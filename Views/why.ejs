<%- include("partials/header") -%>

<main style="background-color: var(--eco-bg); min-height: 100vh;">
  <section class="eco-hero" style="background: linear-gradient(135deg, var(--eco-primary-dark) 0%, var(--eco-primary) 100%); color: white; padding: 80px 24px;">
    <div class="eco-container text-center">
      <h3 style="color: var(--eco-accent-soft); font-size: 18px; font-weight: 600; margin-bottom: 16px;">The Path to a Sustainable Future</h3>
      <h1 style="color: white; font-size: 48px; font-weight: 800; margin-bottom: 24px;">Why EcoPulse?</h1>
      <p style="font-size: 18px; opacity: 0.9; max-width: 800px; margin: 0 auto; line-height: 1.6;">
        While reducing our footprint must be the priority, certain emissions are currently impossible to completely avoid. That's where AI insights and offsets come into play. EcoPulse empowers you to manage emissions intelligently.
      </p>
    </div>
  </section>

  <section class="eco-section eco-container">
    <div class="text-center mb-5">
      <h2 style="color: var(--eco-primary-dark);">How EcoPulse Works</h2>
    </div>

    <div class="eco-grid eco-grid-3">
      <!-- Card 1 -->
      <div class="eco-card text-center d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/whyimage1.png" alt="Role of Offsets" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 24px; flex-grow: 1;">
          <h3 style="font-size: 20px; margin-bottom: 12px;">Data-Driven Intelligence</h3>
          <p style="font-size: 15px; color: var(--eco-text-secondary); margin-bottom: 0;">
            EcoPulse helps you compensate for residual emissions while we work towards systemic changes. By tracking and contributing, you help shape a better earth.
          </p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="eco-card text-center d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/whyimage2.jpg" alt="Individuals" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 24px; flex-grow: 1;">
          <h3 style="font-size: 20px; margin-bottom: 12px;">For Individuals</h3>
          <p style="font-size: 15px; color: var(--eco-text-secondary); margin-bottom: 0;">
            Take a proactive stance against climate change by balancing out emissions, discovering personalized reduction tactics, and funding clean projects globally.
          </p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="eco-card text-center d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/whyimage3.jpg" alt="Businesses" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 24px; flex-grow: 1;">
          <h3 style="font-size: 20px; margin-bottom: 12px;">For Businesses</h3>
          <p style="font-size: 15px; color: var(--eco-text-secondary); margin-bottom: 0;">
            Demonstrate environmental responsibility, build a stronger reputation, attract conscious customers, and achieve cost management through carbon intelligence.
          </p>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include("partials/footer") -%>
