<%- include("partials/header") -%>

<main style="background-color: var(--eco-bg); min-height: 100vh; padding: 80px 24px;">
  <div class="eco-container">
    <div class="text-center mb-5">
      <h1 style="color: var(--eco-primary-dark); font-size: 48px; font-weight: 800; margin-bottom: 16px;">Our Team</h1>
      <p style="color: var(--eco-text-secondary); max-width: 600px; margin: 0 auto; font-size: 16px;">
        Meet the passionate engineers behind EcoPulse.
      </p>
    </div>

    <div class="eco-grid eco-grid-2" style="max-width: 800px; margin: 0 auto;">
      <div class="eco-card text-center">
        <h3 style="font-size: 20px; color: var(--eco-text); margin-bottom: 8px;">Team Member 1</h3>
        <p style="color: var(--eco-text-secondary); margin: 0; font-size: 15px;">Electrical Engineering, IIT BHU</p>
      </div>
      
      <div class="eco-card text-center">
        <h3 style="font-size: 20px; color: var(--eco-text); margin-bottom: 8px;">Team Member 2</h3>
        <p style="color: var(--eco-text-secondary); margin: 0; font-size: 15px;">Electrical Engineering, IIT BHU</p>
      </div>

      <div class="eco-card text-center">
        <h3 style="font-size: 20px; color: var(--eco-text); margin-bottom: 8px;">Team Member 3</h3>
        <p style="color: var(--eco-text-secondary); margin: 0; font-size: 15px;">Electrical Engineering, IIT BHU</p>
      </div>
      
      <div class="eco-card text-center">
        <h3 style="font-size: 20px; color: var(--eco-text); margin-bottom: 8px;">Team Member 4</h3>
        <p style="color: var(--eco-text-secondary); margin: 0; font-size: 15px;">Electrical Engineering, IIT BHU</p>
      </div>
    </div>
  </div>
</main>

<%- include("partials/footer") -%>
