<%- include("partials/header") -%>

<main style="background-color: var(--eco-bg); min-height: 100vh;">
  <section class="eco-hero" style="background: linear-gradient(135deg, var(--eco-primary-dark) 0%, var(--eco-primary) 100%); color: white; padding: 80px 24px;">
    <div class="eco-container text-center">
      <h3 style="color: var(--eco-accent-soft); font-size: 18px; font-weight: 600; margin-bottom: 16px;">Our Goal</h3>
      <h1 style="color: white; font-size: 48px; font-weight: 800; margin-bottom: 24px;">A future where sustainable decisions are easier to understand and act on.</h1>
      <p style="font-size: 18px; opacity: 0.9; max-width: 800px; margin: 0 auto; line-height: 1.6;">
        We strive to make the world a better place to live in. EcoPulse empowers you to take meaningful action by clarifying complex carbon data.
      </p>
    </div>
  </section>

  <section class="eco-section eco-container">
    <div class="text-center mb-5">
      <h2 style="color: var(--eco-primary-dark);">How We Work</h2>
    </div>

    <div class="eco-grid eco-grid-3">
      <!-- Card 1 -->
      <div class="eco-card text-center d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/visioncard1.jpeg" alt="Sustainability" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 24px; flex-grow: 1;">
          <h3 style="font-size: 20px; margin-bottom: 12px;">Sustainability</h3>
          <p style="font-size: 15px; color: var(--eco-text-secondary); margin-bottom: 0;">
            We start by helping individuals and businesses measure and offset their emissions, providing long-term solutions towards a sustainable Earth.
          </p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="eco-card text-center d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/visioncard2.jpg" alt="Transparency" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 24px; flex-grow: 1;">
          <h3 style="font-size: 20px; margin-bottom: 12px;">Transparency</h3>
          <p style="font-size: 15px; color: var(--eco-text-secondary); margin-bottom: 0;">
            By verifying offsetting through recognized organizations, we ensure that every action taken on our platform has a transparent, measurable impact.
          </p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="eco-card text-center d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/visioncard3.jpg" alt="Accessibility" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 24px; flex-grow: 1;">
          <h3 style="font-size: 20px; margin-bottom: 12px;">Accessibility</h3>
          <p style="font-size: 15px; color: var(--eco-text-secondary); margin-bottom: 0;">
            We are accessible to everyone by providing a range of insights and tools depending on your specific requirements, from individuals to large corporations.
          </p>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include("partials/footer") -%>
