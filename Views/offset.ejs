<%- include("partials/header") -%>

<main style="background-color: var(--eco-bg); min-height: 100vh;">
  <!-- Header -->
  <section class="eco-hero" style="background: linear-gradient(135deg, var(--eco-primary-dark) 0%, var(--eco-primary) 100%); color: white; padding: 60px 24px;">
    <div class="eco-container text-center">
      <h3 style="color: var(--eco-accent-soft); font-size: 18px; font-weight: 600; margin-bottom: 16px;">Your footprint. Earth's Trees. Our Future.</h3>
      <h1 style="color: white; font-size: 48px; font-weight: 800; margin-bottom: 24px;">Offset Your Emissions</h1>
      <p style="font-size: 16px; opacity: 0.9; max-width: 800px; margin: 0 auto; line-height: 1.6;">
        A carbon offset is a tangible way of taking action for the climate. For those emissions you can't reduce, you can plant enough trees through our native tree-planting projects to cover the activity you wish to offset.
      </p>
    </div>
  </section>

  <!-- Quick Offsets -->
  <section class="eco-section eco-container">
    <div class="text-center mb-5">
      <h2 style="color: var(--eco-primary-dark);">Quick Offsets for Individuals</h2>
    </div>

    <div class="eco-grid eco-grid-3">
      <!-- Flight -->
      <div class="eco-card d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/flight.jpeg" alt="Flight" style="width: 100%; height: 160px; object-fit: cover;">
        <div style="padding: 24px; flex: 1; display: flex; flex-direction: column;">
          <h4 style="font-size: 18px; margin-bottom: 8px;">Flight Offsets</h4>
          <p style="font-size: 14px; color: var(--eco-text-secondary); flex: 1;">We will plant enough native trees to offset approximately 0.8 tCO2e. Covers emissions from a long one way economy flight.</p>
          <div class="d-flex align-items-center justify-content-between mt-3">
            <span style="font-size: 20px; font-weight: 700; color: var(--eco-primary-dark);">₹1500</span>
            <button class="btn-eco-primary button1">Pay Now</button>
          </div>
        </div>
      </div>

      <!-- Food & Drink -->
      <div class="eco-card d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/food.jpeg" alt="Food" style="width: 100%; height: 160px; object-fit: cover;">
        <div style="padding: 24px; flex: 1; display: flex; flex-direction: column;">
          <h4 style="font-size: 18px; margin-bottom: 8px;">Food & Drink Offsets</h4>
          <p style="font-size: 14px; color: var(--eco-text-secondary); flex: 1;">Approx 10 tCO2e. Includes emissions from groceries, take-away and dining out for an average household.</p>
          <div class="d-flex align-items-center justify-content-between mt-3">
            <span style="font-size: 20px; font-weight: 700; color: var(--eco-primary-dark);">₹8000</span>
            <button class="btn-eco-primary button2">Pay Now</button>
          </div>
        </div>
      </div>

      <!-- Home Energy -->
      <div class="eco-card d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/light.jpg" alt="Energy" style="width: 100%; height: 160px; object-fit: cover;">
        <div style="padding: 24px; flex: 1; display: flex; flex-direction: column;">
          <h4 style="font-size: 18px; margin-bottom: 8px;">Home Energy Offsets</h4>
          <p style="font-size: 14px; color: var(--eco-text-secondary); flex: 1;">Approx. 8 tCO2e. Includes average electricity and natural gas consumption for a standard household.</p>
          <div class="d-flex align-items-center justify-content-between mt-3">
            <span style="font-size: 20px; font-weight: 700; color: var(--eco-primary-dark);">₹10000</span>
            <button class="btn-eco-primary button3">Pay Now</button>
          </div>
        </div>
      </div>

      <!-- Vehicle -->
      <div class="eco-card d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/vehicle.jpeg" alt="Vehicle" style="width: 100%; height: 160px; object-fit: cover;">
        <div style="padding: 24px; flex: 1; display: flex; flex-direction: column;">
          <h4 style="font-size: 18px; margin-bottom: 8px;">Vehicle Offsets</h4>
          <p style="font-size: 14px; color: var(--eco-text-secondary); flex: 1;">Calculating emissions reduction based on an average distance traveled of 11,400 km per year.</p>
          <div class="d-flex align-items-center justify-content-between mt-3">
            <span style="font-size: 20px; font-weight: 700; color: var(--eco-primary-dark);">₹6000</span>
            <button class="btn-eco-primary button4">Pay Now</button>
          </div>
        </div>
      </div>

      <!-- Total Household -->
      <div class="eco-card d-flex flex-column" style="padding: 0; overflow: hidden;">
        <img src="/images/family.jpg" alt="Family" style="width: 100%; height: 160px; object-fit: cover;">
        <div style="padding: 24px; flex: 1; display: flex; flex-direction: column;">
          <h4 style="font-size: 18px; margin-bottom: 8px;">Total Household Footprint</h4>
          <p style="font-size: 14px; color: var(--eco-text-secondary); flex: 1;">Approx 18 tCO2e. Footprint includes emissions from transport, travel, waste, and food.</p>
          <div class="d-flex align-items-center justify-content-between mt-3">
            <span style="font-size: 20px; font-weight: 700; color: var(--eco-primary-dark);">₹12000</span>
            <button class="btn-eco-primary button5">Pay Now</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Subscriptions -->
  <section class="eco-section eco-container" style="background-color: var(--eco-surface-alt); border-radius: var(--eco-radius-lg); margin-bottom: 60px;">
    <div class="text-center mb-5">
      <h2 style="color: var(--eco-primary-dark);">Climate Care Subscriptions</h2>
      <p style="color: var(--eco-text-secondary); max-width: 600px; margin: 0 auto;">Your monthly subscription reduces your carbon impact while benefiting habitats through native tree planting.</p>
    </div>

    <div class="eco-grid eco-grid-4">
      <!-- Individual -->
      <div class="eco-card text-center d-flex flex-column">
        <h4 style="font-size: 18px; margin-bottom: 8px;">Individual</h4>
        <div style="font-size: 14px; color: var(--eco-text-secondary);">(1 person)</div>
        <div style="font-size: 24px; font-weight: 800; color: var(--eco-primary-dark); margin: 16px 0;">₹1500<span style="font-size: 14px; color: var(--eco-text-secondary);">/mo</span></div>
        <ul style="list-style: none; padding: 0; margin: 0 0 24px 0; font-size: 14px; color: var(--eco-text-secondary); text-align: left; flex: 1;">
          <li style="margin-bottom: 8px;"><i class="fa-solid fa-check text-success me-2"></i> 10 tCO2e/y</li>
          <li style="margin-bottom: 8px;"><i class="fa-solid fa-check text-success me-2"></i> 10 Trees/month</li>
          <li style="margin-bottom: 8px;"><i class="fa-solid fa-check text-success me-2"></i> 120 Trees/year</li>
        </ul>
        <button class="btn-eco-secondary w-100 button6">Subscribe</button>
      </div>

      <!-- Couple -->
      <div class="eco-card text-center d-flex flex-column">
        <h4 style="font-size: 18px; margin-bottom: 8px;">Couple</h4>
        <div style="font-size: 14px; color: var(--eco-text-secondary);">(2 people)</div>
        <div style="font-size: 24px; font-weight: 800; color: var(--eco-primary-dark); margin: 16px 0;">₹2000<span style="font-size: 14px; color: var(--eco-text-secondary);">/mo</span></div>
        <ul style="list-style: none; padding: 0; margin: 0 0 24px 0; font-size: 14px; color: var(--eco-text-secondary); text-align: left; flex: 1;">
          <li style="margin-bottom: 8px;"><i class="fa-solid fa-check text-success me-2"></i> 20 tCO2e/y</li>
          <li style="margin-bottom: 8px;"><i class="fa-solid fa-check text-success me-2"></i> 15 Trees/month</li>
          <li style="margin-bottom: 8px;"><i class="fa-solid fa-check text-success me-2"></i> 180 Trees/year</li>
        </ul>
        <button class="btn-eco-secondary w-100 button7">Subscribe</button>
      </div>

      <!-- Small Family -->
      <div class="eco-card text-center d-flex flex-column" style="border: 2px solid var(--eco-primary);">
        <div class="eco-badge mb-2 mx-auto" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--eco-primary); color: white;">Popular</div>
        <h4 style="font-size: 18px; margin-bottom: 8px;">Small Family</h4>
        <div style="font-size: 14px; color: var(--eco-text-secondary);">(3-5 people)</div>
        <div style="font-size: 24px; font-weight: 800; color: var(--eco-primary-dark); margin: 16px 0;">₹3000<span style="font-size: 14px; color: var(--eco-text-secondary);">/mo</span></div>
        <ul style="list-style: none; padding: 0; margin: 0 0 24px 0; font-size: 14px; color: var(--eco-text-secondary); text-align: left; flex: 1;">
          <li style="margin-bottom: 8px;"><i class="fa-solid fa-check text-success me-2"></i> 30 tCO2e/y</li>
          <li style="margin-bottom: 8px;"><i class="fa-solid fa-check text-success me-2"></i> 20 Trees/month</li>
          <li style="margin-bottom: 8px;"><i class="fa-solid fa-check text-success me-2"></i> 240 Trees/year</li>
        </ul>
        <button class="btn-eco-primary w-100 button8">Subscribe</button>
      </div>

      <!-- Large Family -->
      <div class="eco-card text-center d-flex flex-column">
        <h4 style="font-size: 18px; margin-bottom: 8px;">Large Family</h4>
        <div style="font-size: 14px; color: var(--eco-text-secondary);">(6+ people)</div>
        <div style="font-size: 24px; font-weight: 800; color: var(--eco-primary-dark); margin: 16px 0;">₹5000<span style="font-size: 14px; color: var(--eco-text-secondary);">/mo</span></div>
        <ul style="list-style: none; padding: 0; margin: 0 0 24px 0; font-size: 14px; color: var(--eco-text-secondary); text-align: left; flex: 1;">
          <li style="margin-bottom: 8px;"><i class="fa-solid fa-check text-success me-2"></i> 40 tCO2e/y</li>
          <li style="margin-bottom: 8px;"><i class="fa-solid fa-check text-success me-2"></i> 25 Trees/month</li>
          <li style="margin-bottom: 8px;"><i class="fa-solid fa-check text-success me-2"></i> 300 Trees/year</li>
        </ul>
        <button class="btn-eco-secondary w-100 button9">Subscribe</button>
      </div>
    </div>
  </section>
</main>

<script>
   const button1 = document.querySelector(".button1");
   const button2 = document.querySelector(".button2");
   const button3 = document.querySelector(".button3");
   const button4 = document.querySelector(".button4");
   const button5 = document.querySelector(".button5");
   const button6 = document.querySelector(".button6");
   const button7 = document.querySelector(".button7");
   const button8 = document.querySelector(".button8");
   const button9 = document.querySelector(".button9");
   
   function handlePayment(id) {
     fetch("/create-checkout-session", {
       method: "POST",
       headers: { "Content-Type": "application/json" },
       body: JSON.stringify({ items: [{ id: id, quantity: 1 }] }),
     })
     .then(res => res.ok ? res.json() : res.json().then(json => Promise.reject(json)))
     .then(({ url }) => { window.location = url; })
     .catch(e => console.error(e.error));
   }

   if(button1) button1.addEventListener("click", () => handlePayment(1));
   if(button2) button2.addEventListener("click", () => handlePayment(2));
   if(button3) button3.addEventListener("click", () => handlePayment(3));
   if(button4) button4.addEventListener("click", () => handlePayment(4));
   if(button5) button5.addEventListener("click", () => handlePayment(5));
   if(button6) button6.addEventListener("click", () => handlePayment(6));
   if(button7) button7.addEventListener("click", () => handlePayment(7));
   if(button8) button8.addEventListener("click", () => handlePayment(8));
   if(button9) button9.addEventListener("click", () => handlePayment(9));
</script>

<%- include("partials/footer") -%>
